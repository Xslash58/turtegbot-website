{
	"name": "turtegbot-website",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 3000",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm exec prettier --check .",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.3.1",
		"@eslint/js": "^9.32.0",
		"@sveltejs/adapter-auto": "^6.0.1",
		"@sveltejs/kit": "^2.27.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@types/d3-drag": "^3.0.7",
		"@types/d3-force": "^3.0.10",
		"@types/d3-selection": "^3.0.13",
		"@types/d3-zoom": "^3.0.9",
		"eslint": "^9.32.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.11.0",
		"globals": "^16.5.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.37.3",
		"svelte-check": "^4.3.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^7.0.6"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"d3-drag": "^3.0.1",
		"d3-force": "^3.0.1",
		"d3-selection": "^3.0.1",
		"d3-zoom": "^3.0.1",
		"phosphor-svelte": "^3.0.1",
		"sass-embedded": "^1.89.2",
		"scss": "^0.2.4"
	}
}
